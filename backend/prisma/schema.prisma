// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TripVisibility {
  PUBLIC
  PRIVATE
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  email     String   @unique
  password  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  trips     Trip[]
}

model Trip {
  id          String         @id @default(uuid()) @db.Uuid
  userId      String         @db.Uuid
  title       String
  description String?
  coverImage  String?
  startDate   DateTime
  endDate     DateTime
  visibility  TripVisibility @default(PRIVATE)
  createdAt   DateTime       @default(now())
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  stops       TripStop[]

  @@index([userId])
}

model City {
  id               String     @id @default(uuid()) @db.Uuid
  name             String
  country          String
  latitude         Float
  longitude        Float
  averageDailyCost Float
  image            String?
  activities       Activity[]
  tripStops        TripStop[]
}

model Activity {
  id            String         @id @default(uuid()) @db.Uuid
  cityId        String         @db.Uuid
  title         String
  description   String?
  category      String
  duration      Int
  estimatedCost Float
  image         String?
  city          City           @relation(fields: [cityId], references: [id], onDelete: Cascade)
  tripActivities TripActivity[]

  @@index([cityId])
}

model TripStop {
  id            String         @id @default(uuid()) @db.Uuid
  tripId        String         @db.Uuid
  cityId        String         @db.Uuid
  arrivalDate   DateTime
  departureDate DateTime
  stopOrder     Int
  trip          Trip           @relation(fields: [tripId], references: [id], onDelete: Cascade)
  city          City           @relation(fields: [cityId], references: [id])
  activities    TripActivity[]

  @@unique([tripId, stopOrder])
  @@index([cityId])
}

model TripActivity {
  id         String    @id @default(uuid()) @db.Uuid
  tripStopId String    @db.Uuid
  activityId String    @db.Uuid
  dayNumber  Int
  startTime  String?
  notes      String?
  tripStop   TripStop  @relation(fields: [tripStopId], references: [id], onDelete: Cascade)
  activity   Activity  @relation(fields: [activityId], references: [id])

  @@unique([tripStopId, activityId, dayNumber])
  @@index([activityId])
}
